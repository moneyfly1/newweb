# 在现有 .gitignore 基础上添加备份目录
backups/
*.backup
*_backup.*
# 环境与敏感配置（保留 .env.example 作模板）
.env
.env.local
.env.*.local

# macOS
.DS_Store

# 构建产物与二进制
/server
/cboard
*.exe
*.dll
*.so
*.dylib

# 前端
frontend/node_modules/
frontend/dist/

# 数据库与备份（不上传至 GitHub）
*.db
*.db-shm
*.db-wal
cboard.db
cboard.db-shm
cboard.db-wal
backups/
# uploads 目录及模板可提交（temp.yaml 为 Clash 模板）
# GeoIP/地理数据库为运行时下载的二进制数据，不提交
uploads/config/*.dat
uploads/config/*.mmdb
uploads/config/*.metadb
uploads/config/stash_temp.yaml

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo
.claude/

# Go
*.test
*.out
vendor/

# 日志与临时文件
*.log
tmp/
temp/
*.pid
